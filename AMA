        // Eliminar trabajador
        function eliminarTrabajador(index) {
            trabajadores.splice(index, 1);
            localStorage.setItem("trabajadores", JSON.stringify(trabajadores));
            actualizarListaTrabajadores();
            Swal.fire("Éxito", "Trabajador eliminado correctamente", "success");
        }

        // Registrar jornada laboral
        document.getElementById("registroJornadaForm").addEventListener("submit", function(event) {
            event.preventDefault();
	    let trabajadorSeleccionado = document.getElementById("nombreTrabajadorJornada").value;
	    let [nombreTrabajador, numeroDocumento] = trabajadorSeleccionado.split(" - ");
	    let sede = document.getElementById("sede").value;
	    let linea = document.getElementById("linea").value; // Obtener la línea
	    let fecha = document.getElementById("fechaJornada").value;
	    let horaInicio = document.getElementById("horaInicio").value;
	    let horaFin = document.getElementById("horaFin").value;
	    let horasDescuento = parseFloat(document.getElementById("horasDescuento").value) || 0;
	    let tipoJornada = document.getElementById("tipoJornada").value;

            // Validar campos obligatorios
            if (!cedula || !nombreTrabajador || !sede || !linea || !fecha || !horaInicio || !horaFin || !tipoJornada) {
                Swal.fire("Error", "Todos los campos son obligatorios", "error");
                return;
            }

            // Calcular horas trabajadas
            let horasTrabajadas = calcularHoras(horaInicio, horaFin) - horasDescuento;
            if (horasTrabajadas < 0) horasTrabajadas = 0;

            // Calcular horas extras
            let horasExtras = Math.max(0, horasTrabajadas - 8); // Horas extras después de 8 horas

            // Buscar tarifa para la sede
            let tarifaSede = tarifas.find(t => t.sede === sede);
            if (!tarifaSede) {
                Swal.fire("Error", "No se encontraron tarifas para la sede seleccionada", "error");
                return;
            }

            // Calcular valor total
            let valorTotal = 0;
            if (tipoJornada === "diurna") {
                valorTotal = (Math.min(horasTrabajadas, 8) * tarifaSede.diurna) + (horasExtras * tarifaSede.extraDiurna);
            } else if (tipoJornada === "nocturna") {
                valorTotal = (Math.min(horasTrabajadas, 8) * tarifaSede.nocturna) + (horasExtras * tarifaSede.extraNocturna);
            } else if (tipoJornada === "dominical") {
                valorTotal = horasTrabajadas * tarifaSede.dominical; // Tarifa dominical/festiva
            }

            // Registrar la jornada
            let registro = { nombre, sede, linea, fecha, horaInicio, horaFin, horasTrabajadas, horasExtras, tipoJornada, valorTotal };
            registrosJornadas.push(registro);
            localStorage.setItem("registrosJornadas", JSON.stringify(registrosJornadas));
            mostrarRegistrosJornadas();
            Swal.fire("Éxito", "Jornada registrada correctamente", "success");
            this.reset();
            cerrarModalJornada();
        });

        // Calcular horas trabajadas

function calcularHoras(inicio, fin) {
    let inicioHora = new Date(`1970-01-01T${inicio}:00`);
    let finHora = new Date(`1970-01-01T${fin}:00`);
    if (finHora < inicioHora) {
        finHora.setDate(finHora.getDate() + 1);
    }
    return (finHora - inicioHora) / (1000 * 60 * 60); // Convertir a horas
}


        // Mostrar registros de jornadas
        function mostrarRegistrosJornadas() {
    let tbody = document.getElementById("tablaRegistrosJornadas");
    tbody.innerHTML = "";
    let totalPago = 0;
    registrosJornadas.forEach((registro, index) => {
        let claseExceso = registro.horasTrabajadas > 8 ? "exceso-horas" : "";
        let fila = `<tr class="${claseExceso}">
            <td>${registro.nombre}</td>
            <td>${registro.sede}</td>
            <td>${registro.linea}</td>
            <td>${registro.fecha}</td>
            <td>${registro.horaInicio}</td>
            <td>${registro.horaFin}</td>
            <td>${registro.horasTrabajadas.toFixed(2)} h</td>
            <td>${registro.horasExtras.toFixed(2)} h</td>
            <td>${registro.tipoJornada}</td>
            <td>$${registro.valorTotal.toLocaleString()}</td>
            <td>
                <button class="btn-editar" onclick="abrirModalEditarJornada(${index})">Editar</button>
                <button class="btn-eliminar" onclick="eliminarJornada(${index})">Eliminar</button>
            </td>
        </tr>`;
        tbody.innerHTML += fila;
        totalPago += registro.valorTotal;
    });
    document.getElementById("totalPagoJornadas").textContent = `Total a pagar: $${totalPago.toLocaleString()}`;
}        document.addEventListener("DOMContentLoaded", mostrarRegistrosJornadas);

        // Actualizar jornadas con las nuevas tarifas
        function actualizarJornadas() {
            registrosJornadas.forEach(registro => {
                let tarifaSede = tarifas.find(t => t.sede === registro.sede);
                if (tarifaSede) {
                    let horasExtras = Math.max(0, registro.horasTrabajadas - 8);
                    if (registro.tipoJornada === "diurna") {
                        registro.valorTotal = (Math.min(registro.horasTrabajadas, 8) * tarifaSede.diurna) + (horasExtras * tarifaSede.extraDiurna);
                    } else if (registro.tipoJornada === "nocturna") {
                        registro.valorTotal = (Math.min(registro.horasTrabajadas, 8) * tarifaSede.nocturna) + (horasExtras * tarifaSede.extraNocturna);
                    } else if (registro.tipoJornada === "dominical") {
                        registro.valorTotal = registro.horasTrabajadas * tarifaSede.dominical;
                    }
                }
            });
            localStorage.setItem("registrosJornadas", JSON.stringify(registrosJornadas));
            mostrarRegistrosJornadas();
            Swal.fire("Éxito", "Jornadas actualizadas con las nuevas tarifas", "success");
        }

        // Registrar tarifas
        document.getElementById("tarifasForm").addEventListener("submit", function(event) {
            event.preventDefault();
            let sede = document.getElementById("sedeTarifa").value;
            let tarifaDiurna = parseFloat(document.getElementById("tarifaDiurna").value);
            let tarifaExtraDiurna = parseFloat(document.getElementById("tarifaExtraDiurna").value);
            let tarifaNocturna = parseFloat(document.getElementById("tarifaNocturna").value);
            let tarifaExtraNocturna = parseFloat(document.getElementById("tarifaExtraNocturna").value);
            let tarifaDominical = parseFloat(document.getElementById("tarifaDominical").value);

            // Verificar si ya existe una tarifa para esta sede
            let tarifaExistente = tarifas.find(t => t.sede === sede);
            if (tarifaExistente) {
                // Actualizar tarifa existente
                tarifaExistente.diurna = tarifaDiurna;
                tarifaExistente.extraDiurna = tarifaExtraDiurna;
                tarifaExistente.nocturna = tarifaNocturna;
                tarifaExistente.extraNocturna = tarifaExtraNocturna;
                tarifaExistente.dominical = tarifaDominical;
            } else {
                // Crear nueva tarifa
                tarifas.push({
                    sede: sede,
                    diurna: tarifaDiurna,
                    extraDiurna: tarifaExtraDiurna,
                    nocturna: tarifaNocturna,
                    extraNocturna: tarifaExtraNocturna,
                    dominical: tarifaDominical
                });
            }
            localStorage.setItem("tarifas", JSON.stringify(tarifas));
            mostrarTarifas();
            Swal.fire("Éxito", "Tarifa registrada correctamente", "success");
            this.reset();
            cerrarModalTarifa();
        });

        // Mostrar tarifas
        function mostrarTarifas() {
            let tbody = document.getElementById("tablaTarifas");
            tbody.innerHTML = "";
            tarifas.forEach((tarifa, index) => {
                let fila = `<tr>
                    <td>${tarifa.sede}</td>
                    <td>$${tarifa.diurna.toLocaleString()}</td>
                    <td>$${tarifa.extraDiurna.toLocaleString()}</td>
                    <td>$${tarifa.nocturna.toLocaleString()}</td>
                    <td>$${tarifa.extraNocturna.toLocaleString()}</td>
                    <td>$${tarifa.dominical.toLocaleString()}</td>
                    <td><button class="btn-eliminar" onclick="eliminarTarifa(${index})">Eliminar</button></td>
                </tr>`;
                tbody.innerHTML += fila;
            });
        }
        document.addEventListener("DOMContentLoaded", mostrarTarifas);

        // Eliminar tarifa
        function eliminarTarifa(index) {
            tarifas.splice(index, 1);
            localStorage.setItem("tarifas", JSON.stringify(tarifas));
            mostrarTarifas();
            Swal.fire("Éxito", "Tarifa eliminada correctamente", "success");
        }

        // Registrar sede
        document.getElementById("sedesForm").addEventListener("submit", function(event) {
            event.preventDefault();
            let nombreSede = document.getElementById("nombreSede").value;
            let lineaSede = document.getElementById("lineaSede").value;

            // Validar campos obligatorios
            if (!nombreSede || !lineaSede) {
                Swal.fire("Error", "Todos los campos son obligatorios", "error");
                return;
            }

            // Verificar si ya existe una sede con el mismo nombre
            if (sedes.some(sede => sede.nombre === nombreSede)) {
                Swal.fire("Error", "Ya existe una sede con este nombre", "error");
                return;
            }

            // Registrar la sede
            let sede = { nombre: nombreSede, linea: lineaSede };
            sedes.push(sede);
            localStorage.setItem("sedes", JSON.stringify(sedes));
            mostrarSedes();
            Swal.fire("Éxito", "Sede registrada correctamente", "success");
            this.reset();
            cerrarModalSede();
        });

