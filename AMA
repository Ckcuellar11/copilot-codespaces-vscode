</div>

        <!-- Sección de Registro de Trabajadores -->
        <div id="registro" class="container">
            <h2>Registro de Trabajadores</h2>
            <button onclick="abrirModalTrabajador()">Ingresar Nuevo Trabajador</button>
            <h2>Lista de Trabajadores</h2>
            <div class="filtro">
                <input type="text" id="filtroTrabajadores" placeholder="Buscar por nombre o número de documento" oninput="filtrarTrabajadores()">
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo de Documento</th>
                        <th>Número de Documento</th>
                        <th>Residencia</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="listaTrabajadores"></tbody>
            </table>
        </div>

        <!-- Modal para Registrar Trabajadores -->
        <div id="modalTrabajadores" class="modal">
            <div class="modal-contenido">
                <h2>Registrar Trabajador</h2>
                <form id="registroForm">
                    <label>Tipo de Documento:</label>
                    <select id="tipoDocumento" required>
                        <option value="CC">Cédula de Ciudadanía</option>
                        <option value="TI">Tarjeta de Identidad</option>
                        <option value="CE">Cédula de Extranjería</option>
                        <option value="Pasaporte">Pasaporte</option>
                    </select>
                    <label>Número de Documento:</label>
                    <input type="text" id="numeroDocumento" required>
                    <label>Nombre del Trabajador:</label>
                    <input type="text" id="nombreTrabajador" required>
                    <label>Lugar de Residencia:</label>
                    <input type="text" id="residencia" required>
                    <button type="submit">Registrar Trabajador</button>
                </form>
                <button class="modal-cerrar" onclick="cerrarModalTrabajador()">Cerrar</button>
            </div>
        </div>

        <!-- Sección de Registro de Jornadas Laborales -->
        <div id="jornadas" class="container">
            <h2>Registro de Jornadas Laborales</h2>
            <button onclick="abrirModalJornada()">Registrar Nuevo Turno</button>
            <button onclick="actualizarJornadas()">Actualizar Jornadas</button>
            <button onclick="descargarExcel()">Descargar Excel</button>
            <h2>Registros de Jornadas</h2>
            <div class="filtro">
                <input type="text" id="filtroBusqueda" placeholder="Buscar por nombre o número de documento" oninput="filtrarJornadas()">
            </div>
            <div class="filtro">
                <select id="filtroSede" onchange="filtrarJornadas()">
                    <option value="">Todas las sedes</option>
                </select>
            </div>
            <div class="filtro-rango-fechas">
                <input type="date" id="fechaInicio" onchange="filtrarJornadas()">
                <input type="date" id="fechaFin" onchange="filtrarJornadas()">
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Cedula</th>
			<th>Nombre del trabajador</th>
                        <th>Sede</th>
                        <th>Línea</th>
                        <th>Fecha</th>
                        <th>Hora Inicio</th>
                        <th>Hora Fin</th>
                        <th>Horas Trabajadas</th>
                        <th>Horas Extras</th>
                        <th>Tipo de Jornada</th>
                        <th>Valor Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaRegistrosJornadas"></tbody>
            </table>
            <div class="total" id="totalPagoJornadas"></div>
        </div>

        <!-- Modal para Registrar Jornadas Laborales -->
        <div id="modalJornadas" class="modal">
            <div class="modal-contenido">
                <h2>Registrar Jornada Laboral</h2>
                <form id="registroJornadaForm">
                    <label>Nombre del trabajador:</label>
                    <select id="nombreTrabajadorJornada" required>
                        <option value="">Seleccione un trabajador</option>
                    </select>
                    <label>Sede de trabajo:</label>
                    <select id="sede" required onchange="cargarLineas()">
                        <option value="">Seleccione una sede</option>
                    </select>
                    <label>Línea:</label>
                    <select id="linea" required>
                        <option value="">Seleccione una línea</option>
                    </select>
                    <label>Fecha:</label>
                    <input type="date" id="fechaJornada" required>
                    <label>Hora de inicio:</label>
                    <input type="time" id="horaInicio" required>
                    <label>Hora de fin:</label>
                    <input type="time" id="horaFin" required>
                    <label>Horas a descontar:</label>
                    <input type="number" id="horasDescuento" min="0" step="0.5" value="0">
                    <label>Tipo de Jornada:</label>
                    <select id="tipoJornada" required>
                        <option value="diurna">Diurna</option>
                        <option value="nocturna">Nocturna</option>
